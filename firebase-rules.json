{
  "rules": {
    "assessments": {
      ".read": true,
      ".write": true,
      "$assessmentId": {
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'createdAt'])"
      }
    },
    "questions": {
      ".read": true,
      ".write": true,
      ".indexOn": ["assessmentId"],
      "$questionId": {
        ".validate": "!newData.exists() || newData.hasChildren(['assessmentId', 'question'])"
      }
    },
    "submissions": {
      ".read": true,
      ".write": true,
      ".indexOn": ["asmId"],
      "$submissionId": {
        ".validate": "!newData.exists() || newData.hasChildren(['agentName', 'asmId'])"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
